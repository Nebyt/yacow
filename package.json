{
  "name": "yacow",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "YACOW -- Yet Another Cardano Only Wallet: a lightweight interactive terminal wallet for Cardano",
  "type": "module",
  "bin": {
    "yacow": "./src/cli.tsx"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "bun src/cli.tsx",
    "dev": "bun src/cli.tsx",
    "smoke": "bun scripts/smoke.tsx",
    "test": "NODE_ENV=jest bunx jest",
    "test:ui": "bun run smoke",
    "test:all": "bun run test && bun run smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@emurgo/cardano-serialization-lib-nodejs": "14.1.2",
    "@emurgo/cip4-js": "1.0.5",
    "@opentui/core": "^0.5.12",
    "@opentui/react": "^0.5.12",
    "bip39": "3.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/zxcvbn": "^4.4.5",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "typescript": "^5.4.5",
    "undici": "^8.10.1"
  }
}
